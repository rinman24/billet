# Optional auth-tooling recipe — the GitHub CLI (`gh`), binary part.
#
# Merge into the repo's dev-container Dockerfile ONLY if this Workspace actually calls
# `gh`. A recipe is two parts and needs both: the CLI baked into the image (below) and
# its credential store on a named volume (gh.docker-compose.snippet.yml). Either part
# alone still costs a manual step after every rebuild — the binary is reinstalled by
# hand, or `gh auth login` is run again. There is no image-side mountpoint to create: the
# Berth entrypoint re-owns a root-owned, empty Locker to `dev` at container start
# (ADR-0013), so the volume part is the compose snippet alone.
#
# Assumes the base image already has ca-certificates and curl (Dockerfile.snippet's apt
# layer is the natural place to add them if not).

# --- Install `gh` from GitHub's apt repository, GPG-pinned ----------------------------
# The same shape as every other third-party source: keyring under /etc/apt/keyrings, a
# source list pinned to it with signed-by. Unlike nodesource's and Microsoft's ASCII
# keys, GitHub publishes an already-dearmored keyring, so it is fetched as-is rather than
# piped through `gpg --dearmor`. The `gh` version floats with the pinned repo, exactly as
# the base image's other apt sources do; reproducibility comes from the base image tag.
# The alternative — a pinned release tarball into /usr/local/bin — trades that for a
# manual version bump, and is only worth it if a specific `gh` version is required.
RUN set -eux; \
    mkdir -p /etc/apt/keyrings; \
    curl -fsSL -o /etc/apt/keyrings/githubcli.gpg \
        https://cli.github.com/packages/githubcli-archive-keyring.gpg; \
    chmod 0644 /etc/apt/keyrings/githubcli.gpg; \
    echo "deb [signed-by=/etc/apt/keyrings/githubcli.gpg] https://cli.github.com/packages stable main" \
        > /etc/apt/sources.list.d/github-cli.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends gh; \
    rm -rf /var/lib/apt/lists/*; \
    gh --version
